# Copy to .env in this folder and edit. `docker compose` reads .env automatically.
#   cp .env.example .env && nano .env

# Subdomain the API is served on. A DNS A record for this name MUST point at the server's IP.
API_DOMAIN=api.pdfpilot.pro

# Email for Let's Encrypt certificate notices (any mailbox you check).
ACME_EMAIL=you@example.com

# Absolute path on the server to the app secrets file (see pdfpilot-api.env.example).
# Kept outside the git repo so secrets are never committed.
PDFPILOT_ENV_FILE=/home/pdfpilot/pdfpilot-api.env
