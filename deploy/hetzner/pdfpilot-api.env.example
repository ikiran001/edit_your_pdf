# App secrets for the pdfpilot API container.
# On the server, copy this to the path set in .env (PDFPILOT_ENV_FILE), e.g.:
#   cp deploy/hetzner/pdfpilot-api.env.example /home/pdfpilot/pdfpilot-api.env
#   chmod 600 /home/pdfpilot/pdfpilot-api.env
#   nano /home/pdfpilot/pdfpilot-api.env
# Copy the secret values from Render Dashboard → your service → Environment.
# Never commit the real file.

NODE_ENV=production
PORT=3001
HEALTH_VERBOSE=1
SOFFICE_PATH=/usr/bin/soffice
OCR_LANGS=eng+hin
# Browser origins allowed to call the API. Must include your live frontend (GitHub Pages).
ALLOWED_ORIGINS=https://pdfpilot.pro,https://www.pdfpilot.pro
# One reverse-proxy hop (Caddy) sits in front of the API.
TRUST_PROXY_HOPS=1

# --- Paste from Render (one line each) ---
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# RAZORPAY_KEY_ID=rzp_live_xxxx
# RAZORPAY_KEY_SECRET=xxxx
# RAZORPAY_WEBHOOK_SECRET=xxxx

# --- Optional ---
# OPENAI_API_KEY=sk-...
# FEEDBACK_ADMIN_SECRET=...
# LIBRETRANSLATE_API_KEY=...
