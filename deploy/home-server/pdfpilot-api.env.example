# Copy to ~/pdfpilot-api.env on the Linux server (chmod 600).
# Never commit the real file. Copy secrets from Render Dashboard → Environment.
#
#   cp deploy/home-server/pdfpilot-api.env.example ~/pdfpilot-api.env
#   chmod 600 ~/pdfpilot-api.env
#   nano ~/pdfpilot-api.env

NODE_ENV=production
PORT=3001
HEALTH_VERBOSE=1
SOFFICE_PATH=/usr/bin/soffice
OCR_LANGS=eng+hin
ALLOWED_ORIGINS=https://pdfpilot.pro,https://www.pdfpilot.pro
TRUST_PROXY_HOPS=1

# --- Paste from Render (one line each) ---
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# RAZORPAY_KEY_ID=rzp_live_xxxx
# RAZORPAY_KEY_SECRET=xxxx
# RAZORPAY_WEBHOOK_SECRET=xxxx

# --- Optional ---
# OPENAI_API_KEY=sk-...
# FEEDBACK_ADMIN_SECRET=...
# LIBRETRANSLATE_API_KEY=...
